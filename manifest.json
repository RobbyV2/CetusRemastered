{
    "manifest_version": 3,
    "name": "Cetus Remastered",
    "version": "2.0.0",
    "description": "Dynamic analysis extension for WebAssembly",
    "minimum_chrome_version": "121",
    "background": {
        "service_worker": "extension/background.js",
        "scripts": ["extension/background.js"]
    },
    "action": {
        "default_title": "Cetus Remastered",
        "default_popup": "extension/popupview.html"
    },
    "devtools_page": "extension/devtools.html",
    "commands": {
        "toggle-speedhack": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Toggle the speedhack" },
        "toggle-freezes": { "suggested_key": { "default": "Alt+Shift+F" }, "description": "Suspend or resume all freezes" },
        "toggle-pause": { "suggested_key": { "default": "Alt+Shift+P" }, "description": "Pause or resume the game" }
    },
    "permissions": ["storage"],
    "host_permissions": ["<all_urls>"],
    "content_scripts": [
        {
            "js": ["shared/utils.js", "shared/wail.min.js/wail.min.js", "content/cetus.js", "content/init.js"],
            "world": "MAIN",
            "matches": ["<all_urls>"],
            "all_frames": true,
            "match_about_blank": true,
            "run_at": "document_start"
        },
        {
            "js": ["content/content.js"],
            "matches": ["<all_urls>"],
            "all_frames": true,
            "match_about_blank": true,
            "run_at": "document_start"
        }
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "cetus-remastered@cetus.extension",
            "strict_min_version": "128.0"
        }
    },
    "icons": {
        "16": "icons/cetus16.png",
        "48": "icons/cetus48.png",
        "128": "icons/cetus128.png"
    }
}
